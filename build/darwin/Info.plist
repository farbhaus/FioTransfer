<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>CFBundleName</key>
        <string>FioTransfer</string>
        <key>CFBundleExecutable</key>
        <string>FioTransfer</string>
        <key>CFBundleIdentifier</key>
        <string>com.farbhaus.fiotransfer</string>
        <key>CFBundleVersion</key>
        <string>1.0.0</string>
        <key>CFBundleGetInfoString</key>
        <string>Fast Frame.io uploads and downloads</string>
        <key>CFBundleShortVersionString</key>
        <string>1.0.0</string>
        <key>CFBundleIconFile</key>
        <string>iconfile</string>
        <key>LSMinimumSystemVersion</key>
        <string>13.0</string>
        <key>NSHighResolutionCapable</key>
        <string>true</string>
        <key>NSHumanReadableCopyright</key>
        <string>Copyright © 2026 farbhaus</string>
        <!-- Finder's right-click menu, served by sys/mac/services_darwin.m. -->
        <key>NSServices</key>
        <array>
            <dict>
                <key>NSMenuItem</key>
                <dict>
                    <key>default</key>
                    <string>Upload with FioTransfer</string>
                </dict>
                <key>NSMessage</key>
                <string>fioUpload</string>
                <key>NSPortName</key>
                <string>FioTransfer</string>
                <key>NSRequiredContext</key>
                <dict/>
                <key>NSSendFileTypes</key>
                <array>
                    <string>public.item</string>
                </array>
            </dict>
            <dict>
                <key>NSMenuItem</key>
                <dict>
                    <key>default</key>
                    <string>Create Watch Folder in FioTransfer</string>
                </dict>
                <key>NSMessage</key>
                <string>fioWatch</string>
                <key>NSPortName</key>
                <string>FioTransfer</string>
                <key>NSRequiredContext</key>
                <dict/>
                <key>NSSendFileTypes</key>
                <array>
                    <string>public.folder</string>
                </array>
            </dict>
        </array>
    </dict>
</plist>
